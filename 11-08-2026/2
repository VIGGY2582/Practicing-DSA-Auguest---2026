class Solution {
    int max = 0;
    int curr = 0;
    public int getMaximumGold(int[][] grid) {
        boolean[][] visited = new boolean [grid.length][grid[0].length]; 
        for(int i =0;i<grid.length;i++){
            for(int j = 0;j<grid[0].length;j++){
                bt(i,j,grid,visited);
            }
        }
        return max;
    }

    void bt(int i , int j , int[][] arr,boolean[][] vis){
        int n = arr.length;
        int m = arr[0].length;
        if(arr[i][j]==0){
            return;
        }
        curr +=arr[i][j];
        vis[i][j]=true;
        max= Math.max(curr,max);
        if( j < m-1 && !vis[i][j+1]){
            bt(i,j+1,arr,vis);
        }
        if(j>0 && !vis[i][j-1]){
            bt(i,j-1,arr,vis);
        }
        if(i<n-1 && !vis[i+1][j]){
            bt(i+1,j,arr,vis);
        }
        if(i>0 && !vis[i-1][j]){
            bt(i-1,j,arr,vis);
        }
        vis[i][j] = false;
        curr-=arr[i][j];
    }

}